{
    "name": "studentmentor-ai",
    "version": "1.0.0",
    "private": true,
    "description": "StudentMentor AI - Monorepo root for Vercel deployment",
    "type": "module",
    "scripts": {
        "dev:frontend": "cd frontend && npm run dev",
        "dev:backend": "cd backend && npm run dev",
        "build": "cd frontend && npm install && npm run build",
        "install:all": "cd frontend && npm install && cd ../backend && npm install"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "express": "^4.19.2",
        "groq-sdk": "^0.37.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.3.0",
        "openai": "^6.15.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "uuid": "^9.0.1"
    },
    "engines": {
        "node": "20.x"
    }
}